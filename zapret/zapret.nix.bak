{ ... }:
{
  environment.etc."zapret-files".source = ./zapret-files;

  services.zapret = {
    enable = true;
    params = [
      "--filter-udp=443"
      "--hostlist=/etc/zapret-files/lists/list-general.txt"
      "--hostlist-exclude=/etc/zapret-files/lists/list-exclude.txt"
      "--ipset-exclude=/etc/zapret-files/lists/ipset-exclude.txt"
      "--dpi-desync=fake"
      "--dpi-desync-repeats=6"
      "--dpi-desync-fake-quic=/etc/zapret-files/bin/quic_initial_www_google_com.bin"
      "--new"
      "--filter-udp=19294-19344,50000-50100"
      "--filter-l7=discord,stun"
      "--dpi-desync=fake"
      "--dpi-desync-fake-discord=/etc/zapret-files/bin/quic_initial_dbankcloud_ru.bin"
      "--dpi-desync-fake-stun=/etc/zapret-files/bin/quic_initial_dbankcloud_ru.bin"
      "--dpi-desync-repeats=6"
      "--new"
      "--filter-tcp=2053,2083,2087,2096,8443"
      "--hostlist-domains=discord.media"
      "--dpi-desync=fake"
      "--dpi-desync-repeats=6"
      "--dpi-desync-fooling=badseq"
      "--dpi-desync-badseq-increment=2"
      "--dpi-desync-fake-tls=/etc/zapret-files/bin/tls_clienthello_www_google_com.bin"
      "--new"
      "--filter-tcp=443"
      "--hostlist=/etc/zapret-files/lists/list-google.txt"
      "--ip-id=zero"
      "--dpi-desync=fake"
      "--dpi-desync-repeats=6"
      "--dpi-desync-fooling=badseq"
      "--dpi-desync-badseq-increment=2"
      "--dpi-desync-fake-tls=/etc/zapret-files/bin/tls_clienthello_www_google_com.bin"
      "--new"
      "--filter-tcp=80,443"
      "--hostlist=/etc/zapret-files/lists/list-general.txt"
      "--hostlist-exclude=/etc/zapret-files/lists/list-exclude.txt"
      "--ipset-exclude=/etc/zapret-files/lists/ipset-exclude.txt"
      "--dpi-desync=fake"
      "--dpi-desync-repeats=6"
      "--dpi-desync-fooling=badseq"
      "--dpi-desync-badseq-increment=2"
      "--dpi-desync-fake-tls=/etc/zapret-files/bin/stun.bin"
      "--dpi-desync-fake-tls=/etc/zapret-files/bin/tls_clienthello_www_google_com.bin"
      "--dpi-desync-fake-http=/etc/zapret-files/bin/tls_clienthello_max_ru.bin"
      "--new"
      "--filter-udp=443"
      "--ipset=/etc/zapret-files/lists/ipset-all.txt"
      "--hostlist-exclude=/etc/zapret-files/lists/list-exclude.txt"
      "--ipset-exclude=/etc/zapret-files/lists/ipset-exclude.txt"
      "--dpi-desync=fake"
      "--dpi-desync-repeats=6"
      "--dpi-desync-fake-quic=/etc/zapret-files/bin/quic_initial_www_google_com.bin"
      "--new"
      "--filter-tcp=80,443,8443"
      "--ipset=/etc/zapret-files/lists/ipset-all.txt"
      "--hostlist-exclude=/etc/zapret-files/lists/list-exclude.txt"
      "--ipset-exclude=/etc/zapret-files/lists/ipset-exclude.txt"
      "--dpi-desync=fake"
      "--dpi-desync-repeats=6"
      "--dpi-desync-fooling=badseq"
      "--dpi-desync-badseq-increment=2"
      "--dpi-desync-fake-tls=/etc/zapret-files/bin/stun.bin"
      "--dpi-desync-fake-tls=/etc/zapret-files/bin/tls_clienthello_www_google_com.bin"
      "--dpi-desync-fake-http=/etc/zapret-files/bin/tls_clienthello_max_ru.bin"
      "--new"
      "--filter-tcp=12"
      "--ipset=/etc/zapret-files/lists/ipset-all.txt"
      "--ipset-exclude=/etc/zapret-files/lists/ipset-exclude.txt"
      "--dpi-desync=fake"
      "--dpi-desync-repeats=6"
      "--dpi-desync-any-protocol=1"
      "--dpi-desync-cutoff=n3"
      "--dpi-desync-fooling=badseq"
      "--dpi-desync-badseq-increment=2"
      "--dpi-desync-fake-tls=/etc/zapret-files/bin/stun.bin"
      "--dpi-desync-fake-tls=/etc/zapret-files/bin/tls_clienthello_www_google_com.bin"
      "--dpi-desync-fake-http=/etc/zapret-files/bin/tls_clienthello_max_ru.bin"
      "--new"
      "--filter-udp=12"
      "--ipset=/etc/zapret-files/lists/ipset-all.txt"
      "--ipset-exclude=/etc/zapret-files/lists/ipset-exclude.txt"
      "--dpi-desync=fake"
      "--dpi-desync-repeats=10"
      "--dpi-desync-any-protocol=1"
      "--dpi-desync-fake-unknown-udp=/etc/zapret-files/bin/quic_initial_dbankcloud_ru.bin"
      "--dpi-desync-cutoff=n2"
      "--new"
      "--filter-udp=443"
      "--hostlist-domains=cloudflareclient.com,cloudflarewarp.com"
      "--dpi-desync=fake"
      "--dpi-desync-repeats=1"
      "--dpi-desync-fake-quic=/etc/zapret-files/bin/quic_initial_dbankcloud_ru.bin"
      "--new"
    ];
    whitelist = [
    ];
  };
}
